<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TrackYourSubs.ViewModels"
    x:Class="TrackYourSubs.Views.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Subscriptions">
<ContentPage.ToolbarItems>
  <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
</ContentPage.ToolbarItems>

  <CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Grid Padding="12" ColumnDefinitions="*,Auto">
          <VerticalStackLayout>
            <Label Text="{Binding Name}" FontAttributes="Bold" />
            <Label Text="{Binding NextBillingDate, StringFormat='Next: {0:yyyy-MM-dd}'}" FontSize="12" />
          </VerticalStackLayout>
          <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:F2}'}" VerticalOptions="Center" />
        </Grid>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
